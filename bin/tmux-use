#!/usr/bin/env bash
# shellcheck disable=1090

# Session file (.tmux.sh in the project root)
#
# Optional bash file defining `setup` and/or `teardown`. `setup` runs right
# after the session is created; `teardown` runs before it's killed.
#
# Write plain tmux commands without session targets or -c: untargeted
# commands hit the newly created session, and new windows/panes start in the
# project dir because tmux-use cd's there first. Only target windows/panes by
# name (`-t run`, `-t run.0`).
#
# Structure `setup` as one block per window, each in this order:
#   1. Window settings: `rename-window` for the first window, `new-window -n`
#      for the rest
#   2. Pane configuration: `send-keys`, `split-window`
#   3. Pane selection (only for windows with several panes): select the main
#      one, usually the pane running the main process
# Then end with window selection, usually the first window.
#
# Example:
#   setup() {
#   	tmux rename-window editor
#   	tmux send-keys "nvim ." C-m
#
#   	tmux new-window -n run
#   	tmux send-keys "python3 -m http.server 8000" C-m
#   	tmux split-window -h
#   	tmux send-keys "watch -n 2 ls -la" C-m
#   	tmux select-pane -t run.0
#
#   	tmux new-window -n shell
#
#   	tmux select-window -t editor
#   }
#
#   teardown() {
#   	tmux send-keys -t run.0 C-c
#   	sleep 1
#   }

# Configurable variable for tmux session file
TMUX_SESSION_FILE="${TMUX_SESSION_FILE:-.tmux.sh}"
# Session files that were reviewed and allowed, as `<sha256>  <path>` lines
TMUX_USE_ALLOW_FILE="${TMUX_USE_ALLOW_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/tmux-use/allowed}"

# tmux is mandatory
if ! command -v tmux &>/dev/null; then
	echo "tmux is not installed" >&2
	exit 1
fi

get_zoxide_results() {
	if ! command -v zoxide &>/dev/null; then
		echo "zoxide is not installed" >&2
		exit 1
	fi
	zoxide query -l
}

select_project() {
	local zoxide_result projects detect_files
	zoxide_result=$(get_zoxide_results)
	[ -z "$zoxide_result" ] && exit 1

	projects=()

	detect_files=(.git .tmux.sh .venv)
	while IFS= read -r line; do
		for file in "${detect_files[@]}"; do
			if [ -e "$line/$file" ]; then
				projects+=("$line")
				break
			fi
		done
	done <<<"$zoxide_result"

	printf "%s\n" "${projects[@]}" | fzf --prompt "Select project: " --cycle
}

select_session() {
	local sessions
	sessions=$(tmux list-sessions -F "#{session_name}")
	[ -z "$sessions" ] && exit 1

	printf "%s\n" "$sessions" | fzf --prompt "Select session: " --cycle
}

get_cwd_session_name() {
	local dir_path
	dir_path="${PWD/#$HOME\//}"
	echo "$dir_path" | tr '/' '-' | sed 's/\.//g'
}

case "$@" in
	*session*setup*)
		PROJECT_DIR=$(select_project)
		[ -z "$PROJECT_DIR" ] && exit 1
		cd "$PROJECT_DIR" || exit 1
		SESSION_NAME=${SESSION_NAME:-$(get_cwd_session_name)}
		;;
	*session*teardown*)
		SESSION_NAME=$(select_session)
		[ -z "$SESSION_NAME" ] && exit 1
		PROJECT_DIR=$(tmux list-windows -t "=$SESSION_NAME" -F "#{pane_current_path}" | head -n 1)
		[ -z "$PROJECT_DIR" ] && exit 1
		cd "$PROJECT_DIR" || exit 1
		;;
esac

# Plain setup/teardown act on the current directory
PROJECT_DIR=${PROJECT_DIR:-$PWD}
SESSION_NAME=${SESSION_NAME:-$(get_cwd_session_name)}

# Session files are code: only source them once reviewed and allowed (like
# `direnv allow`). Any change to the file asks again.
load_session_file() {
	local file="$PROJECT_DIR/$TMUX_SESSION_FILE" hash answer
	[ -f "$file" ] || return 0

	hash=$(sha256sum "$file" | cut -d " " -f 1)
	if grep -qxF "$hash  $file" "$TMUX_USE_ALLOW_FILE" 2>/dev/null; then
		. "$file"
		return
	fi

	if [ ! -t 0 ]; then
		echo "Skipping $file: not allowed yet, run tmux-use from a terminal to review it" >&2
		return 0
	fi

	echo "$file is new or changed since it was last allowed:"
	echo
	bat --paging=never --style=numbers,header --language=bash "$file" 2>/dev/null ||
		cat -n "$file"
	echo
	read -rp "Allow and run it? [y/N] " answer
	case "$answer" in
		[Yy] | [Yy][Ee][Ss])
			mkdir -p "$(dirname "$TMUX_USE_ALLOW_FILE")"
			touch "$TMUX_USE_ALLOW_FILE"
			# Replace any previous hash for this path
			awk -v f="$file" 'substr($0, 67) != f' "$TMUX_USE_ALLOW_FILE" >"$TMUX_USE_ALLOW_FILE.tmp"
			echo "$hash  $file" >>"$TMUX_USE_ALLOW_FILE.tmp"
			mv "$TMUX_USE_ALLOW_FILE.tmp" "$TMUX_USE_ALLOW_FILE"
			. "$file"
			;;
		*) echo "Skipping $file" >&2 ;;
	esac
}
load_session_file

case "${@:-setup}" in
	*setup*)
		if ! tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
			tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR"
			declare -f setup >/dev/null && setup
		fi

		if [ -n "$TMUX" ]; then
			tmux switch-client -t "=$SESSION_NAME"
		else
			tmux attach-session -t "=$SESSION_NAME"
		fi
		;;
	*teardown*)
		declare -f teardown >/dev/null && teardown
		tmux kill-session -t "=$SESSION_NAME"
		;;
	*)
		echo "Usage: $0 {session setup|session teardown|setup|teardown}"
		exit 1
		;;
esac
